# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Kafka cluster id shared by all KRaft nodes (any 22-char base64 UUID).
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Where Python apps running on your host find Kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
